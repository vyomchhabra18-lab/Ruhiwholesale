# ---------- Error handling: real 404 status (no redirect to home / soft-404) ----------
ErrorDocument 404 /404.html

# ---------- Canonical URLs & redirects ----------
<IfModule mod_rewrite.c>
RewriteEngine On

# One host: https://ruhiwholesale.store (HTTPS + non-www)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://ruhiwholesale.store%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.ruhiwholesale\.store$ [NC]
RewriteRule ^ https://ruhiwholesale.store%{REQUEST_URI} [L,R=301]

# /index.html is the same page as /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://ruhiwholesale.store/ [L,R=301]

# Retired duplicate category page -> merged into Ladies Clothing
RewriteRule ^wholesale-ladies-tshirts\.html$ https://ruhiwholesale.store/wholesale-ladies-clothing.html [L,R=301]
</IfModule>

# ---------- Freshness validators (Last-Modified + ETag) ----------
FileETag MTime Size

# ---------- Make sure the server labels WebP correctly ----------
AddType image/webp .webp

# ---------- Compression ----------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/xml text/plain image/svg+xml
</IfModule>

# ---------- Caching (revalidate HTML so updates are picked up quickly) ----------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/xml "access plus 0 seconds"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "\.webp$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
</IfModule>
